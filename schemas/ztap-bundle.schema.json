{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ztap-bundle.schema.json",
  "title": "ZTAP Bundle",
  "description": "Accepts either one ZTAP envelope object or an array of ZTAP envelope objects.",
  "oneOf": [
    {
      "$ref": "ztap-envelope.schema.json"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ztap-envelope.schema.json"
      }
    }
  ]
}
