{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authorization-decision.schema.json",
  "title": "ZTAP Authorization Decision",
  "allOf": [
    {
      "$ref": "ztap-envelope.schema.json#/$defs/common_envelope"
    },
    {
      "type": "object",
      "required": [
        "decision_id",
        "request_hash",
        "control_plane",
        "evaluated_at",
        "authorization_status",
        "policy_refs",
        "reason_codes"
      ],
      "properties": {
        "envelope_type": {
          "const": "authorization_decision"
        },
        "decision_id": {
          "$ref": "ztap-envelope.schema.json#/$defs/non_empty_string"
        },
        "request_hash": {
          "$ref": "ztap-envelope.schema.json#/$defs/non_empty_string"
        },
        "control_plane": {
          "allOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/actor"
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "$ref": "ztap-envelope.schema.json#/$defs/control_plane_role"
                }
              }
            }
          ]
        },
        "evaluated_at": {
          "$ref": "ztap-envelope.schema.json#/$defs/timestamp"
        },
        "authorization_status": {
          "type": "string",
          "enum": [
            "auto_authorized",
            "human_approval_required",
            "human_approved",
            "evidence_required",
            "rejected",
            "expired"
          ]
        },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "ztap-envelope.schema.json#/$defs/non_empty_string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "ztap-envelope.schema.json#/$defs/reason_code"
          }
        },
        "authorized_at": {
          "$ref": "ztap-envelope.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "ztap-envelope.schema.json#/$defs/timestamp"
        },
        "human_approval_ref": {
          "$ref": "ztap-envelope.schema.json#/$defs/human_approval_ref"
        },
        "declared_risk_level": {
          "$ref": "ztap-envelope.schema.json#/$defs/risk_level"
        },
        "evaluated_risk_level": {
          "$ref": "ztap-envelope.schema.json#/$defs/risk_level"
        },
        "risk_evaluation_reason": {
          "type": "string"
        },
        "required_evidence": {
          "oneOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/required_evidence_entry"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "ztap-envelope.schema.json#/$defs/required_evidence_entry"
              }
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "ztap-envelope.schema.json#/$defs/evidence_ref"
          }
        },
        "break_glass_context": {
          "$ref": "ztap-envelope.schema.json#/$defs/break_glass_context"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorization_status": {
                "enum": [
                  "auto_authorized",
                  "human_approved"
                ]
              }
            },
            "required": [
              "authorization_status"
            ]
          },
          "then": {
            "required": [
              "authorized_at",
              "expires_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authorization_status": {
                "enum": [
                  "human_approval_required",
                  "human_approved"
                ]
              }
            },
            "required": [
              "authorization_status"
            ]
          },
          "then": {
            "required": [
              "human_approval_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authorization_status": {
                "const": "human_approved"
              }
            },
            "required": [
              "authorization_status"
            ]
          },
          "then": {
            "properties": {
              "human_approval_ref": {
                "required": [
                  "approved_by",
                  "approved_at",
                  "approval_scope"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authorization_status": {
                "const": "evidence_required"
              }
            },
            "required": [
              "authorization_status"
            ]
          },
          "then": {
            "required": [
              "required_evidence"
            ]
          }
        }
      ]
    }
  ]
}
