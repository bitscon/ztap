        "profile": "org.acme/database",
        "description": "Clear stuck payment processing queue entries blocking all payment transactions. Emergency remediation for INC-2026-0424-001.",
        "parameters": {
          "database": "payments-db",
          "environment": "production",
          "query_id": "clear_stuck_queue_entries",
          "target_table": "payment_queue",
          "filter": { "status": "stuck", "stuck_since_minutes_gt": 30 },
          "estimated_rows_affected": 47,
          "incident_ref": "INC-2026-0424-001"
        },
        "required_capabilities": ["org.acme/run_remediation_query"],
        "risk_level": "critical",
        "expected_outputs": [
          { "type": "deployment_status", "expected": "queue_cleared" },
          { "type": "service_health", "expected": "payment_processing_healthy" }
        ]
      },

      "requested_capabilities": ["org.acme/run_remediation_query"],
      "atomicity_mode": "atomic_required",

      "verification_requirements": [
        {
          "check_id": "chk-09-queue",
          "check_type": "deployment_status",
          "description": "payment_queue must have zero stuck entries after remediation.",
          "required": true,
          "expected_result": { "stuck_entry_count": 0, "target": "payments-db.production.payment_queue" },
          "failure_reason_code": "VERIFY_FAILED"
        },
        {
          "check_id": "chk-09-processing",
          "check_type": "service_health",
          "description": "Payment processing must recover to healthy state within 2 minutes of remediation.",
          "required": true,
          "expected_result": { "status": "healthy", "target": "payment-processing-service.production" },
          "failure_reason_code": "VERIFY_FAILED"
        },
        {
          "check_id": "chk-09-rowcount",
          "check_type": "deployment_status",
          "description": "Rows affected must be between 40 and 60 (within expected range for stuck entries).",
          "required": true,
          "expected_result": { "rows_affected_min": 40, "rows_affected_max": 60 },
          "failure_reason_code": "VERIFY_FAILED"
        }
      ],

      "evidence_requirements": [
        {
          "evidence_type": "approval_record",
          "description": "Incident ticket reference confirming active incident status.",
          "required": true
        },
        {
          "evidence_type": "approval_record",
          "description": "Named incident commander approval for break-glass access.",
          "required": true
        }
      ],

      "constraints": {
        "break_glass": true,
        "incident_ref": "INC-2026-0424-001",
        "compensating_controls": [
          "All query activity is logged to audit store break-glass partition",
          "Query is read-verified before execution by executor",
          "SRE lead monitoring in real-time",
          "Automatic rollback query prepared and staged"
        ],
        "post_incident_review_due": "2026-04-25T12:00:00Z",
        "authorization_expires_in_minutes": 30
      },

