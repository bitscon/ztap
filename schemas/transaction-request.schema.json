{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transaction-request.schema.json",
  "title": "ZTAP Transaction Request",
  "allOf": [
    {
      "$ref": "ztap-envelope.schema.json#/$defs/common_envelope"
    },
    {
      "type": "object",
      "required": [
        "created_at",
        "source_actor",
        "target_actor",
        "requested_action",
        "requested_capabilities",
        "atomicity_mode",
        "verification_requirements"
      ],
      "properties": {
        "envelope_type": {
          "const": "transaction_request"
        },
        "created_at": {
          "$ref": "ztap-envelope.schema.json#/$defs/timestamp"
        },
        "source_actor": {
          "allOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/actor"
            },
            {
              "type": "object",
              "required": [
                "capability_claims"
              ],
              "properties": {
                "role": {
                  "$ref": "ztap-envelope.schema.json#/$defs/source_actor_role"
                },
                "capability_claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "ztap-envelope.schema.json#/$defs/capability"
                  }
                }
              }
            }
          ]
        },
        "target_actor": {
          "allOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/actor"
            },
            {
              "type": "object",
              "required": [
                "capability_claims"
              ],
              "properties": {
                "role": {
                  "$ref": "ztap-envelope.schema.json#/$defs/target_actor_role"
                },
                "capability_claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "ztap-envelope.schema.json#/$defs/capability"
                  }
                }
              }
            }
          ]
        },
        "requested_action": {
          "$ref": "ztap-envelope.schema.json#/$defs/requested_action"
        },
        "requested_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "ztap-envelope.schema.json#/$defs/capability"
          }
        },
        "atomicity_mode": {
          "$ref": "ztap-envelope.schema.json#/$defs/atomicity"
        },
        "verification_requirements": {
          "$ref": "ztap-envelope.schema.json#/$defs/verification_requirements"
        },
        "parent_transaction_id": {
          "$ref": "ztap-envelope.schema.json#/$defs/non_empty_string"
        },
        "evidence_requirements": {
          "oneOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/required_evidence_entry"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "ztap-envelope.schema.json#/$defs/required_evidence_entry"
              }
            }
          ]
        },
        "expiry_request": {
          "oneOf": [
            {
              "$ref": "ztap-envelope.schema.json#/$defs/timestamp"
            },
            {
              "type": "string",
              "pattern": "^P(?!$).+"
            }
          ]
        },
        "constraints": {
          "type": "object"
        },
        "break_glass_context": {
          "$ref": "ztap-envelope.schema.json#/$defs/break_glass_context"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  ]
}
